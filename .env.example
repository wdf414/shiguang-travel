# ============================================================
# Docker Compose 部署配置模板
# 使用方法：复制为 .env，再填入自己的值。.env 已被 .gitignore 忽略。
#   Copy-Item .env.example .env
# ============================================================

# MySQL root 密码（仅供容器内网使用，仍请使用强密码）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# JWT 签名密钥，至少 32 字节随机字符串
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# 管理员自助注册密钥；留空则关闭
ADMIN_REGISTER_KEY=

# DeepSeek / OpenAI 兼容接口
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-chat
AI_MOCK_ENABLED=false
AI_CACHE_TTL_SECONDS=600
AI_RATE_LIMIT_PER_MINUTE=20

# 对外访问端口
WEB_PORT=8088
BACKEND_PORT=8080

# 允许跨域的前端来源（同域部署时可留空或填写域名）
CORS_ALLOWED_ORIGINS=http://localhost:8088

# 首次启动写入演示账号；生产环境可改为 false
DEMO_DATA_ENABLED=true

# 景点照片目录（可选）。Docker Compose 已挂载到 /scenic_photos，默认即可自动找到；
# 手动部署且目录不同时再填写绝对路径。
SCENIC_PHOTO_DIR=
