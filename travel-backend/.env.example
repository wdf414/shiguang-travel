# ============================================================
# 拾光旅行后端本地配置模板
# 使用方法：复制为 .env，再填入自己的值。.env 已被 .gitignore 忽略。
#   Copy-Item .env.example .env
# ============================================================

# ---------- 服务端口 ----------
SERVER_PORT=8080

# ---------- MySQL ----------
DB_URL=jdbc:mysql://localhost:3306/lvyou?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=请填写你的MySQL密码

# ---------- Redis（可选，未启动时会自动降级） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- JWT ----------
# 至少 32 字节的随机字符串，可使用 `openssl rand -base64 48` 生成。
JWT_SECRET=请替换为至少32字节的随机字符串
JWT_EXPIRATION=86400000

# ---------- 管理员注册 ----------
# 留空表示关闭管理员自助注册；需要时配置一个随机密钥。
ADMIN_REGISTER_KEY=

# ---------- 跨域来源 ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---------- AI（DeepSeek OpenAI 兼容接口） ----------
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=请填写你的DeepSeek_API_Key
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=60
# 没有 Key 时是否允许本地兜底结果；正式演示请保持 false。
AI_MOCK_ENABLED=false
AI_CACHE_TTL_SECONDS=600
AI_RATE_LIMIT_PER_MINUTE=20

# ---------- 演示数据 ----------
# 首次启动自动补表、写入测试账号。生产环境请设为 false。
DEMO_DATA_ENABLED=true

# ---------- 日志 ----------
LOG_LEVEL=info
